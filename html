                    for (let i = 1; i <= 3; i++) {
                        starDisplay += i <= stars ? '⭐' : '☆';
                    }

                    if (isUnlocked) {
                        cardsHtml += `
                            <button onclick="loadStage(${stage.id - 1})" class="btn-3d text-left bg-white hover:bg-amber-50/60 rounded-2xl p-3.5 border-2 ${isCompleted ? 'border-emerald-400' : (isBoss ? 'border-rose-400' : 'border-purple-300')} shadow-sm flex items-center justify-between gap-3 cursor-pointer group">
                                <div class="flex items-center gap-3">
                                    <div class="w-12 h-12 rounded-xl ${isBoss ? 'bg-gradient-to-br from-rose-500 to-purple-600' : 'bg-gradient-to-br from-indigo-400 to-purple-500'} text-white flex items-center justify-center text-2xl shadow-inner group-hover:scale-105 transition">
                                        ${stage.bossEmoji}
