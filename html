        // ==========================================
        // 3. GAME STATE MANAGEMENT
        // ==========================================
        let gameState = {
            showPinyin: true,
            hp: 3,
            maxHp: 3,
            score: 0,
            combo: 0,
            maxCombo: 0,
            currentStageIndex: 0,
            stageAttempts: {}, // { stageId: wrongCountInCurrentRun }
            completedStages: {}, // { stageId: starsEarned (1-3) }
            shuffleOptions: false,
            answeredCurrent: false
        };

        // ==========================================
        // 4. SCREEN NAVIGATION & UI UPDATES
        // ==========================================
        function showScreen(screenName) {
            const screens = ['screenStart', 'screenMap', 'screenBattle', 'screenSummary'];
            screens.forEach(id => {
                document.getElementById(id).classList.add('hidden');
            });

            const btnMapNav = document.getElementById('btnMapNav');
            const hudStats = document.getElementById('hudStats');

            if (screenName === 'start') {
                document.getElementById('screenStart').classList.remove('hidden');
                btnMapNav.classList.add('hidden');
                hudStats.classList.add('hidden');
            } else if (screenName === 'map') {
                renderMap();
                document.getElementById('screenMap').classList.remove('hidden');
                btnMapNav.classList.add('hidden');
                hudStats.classList.remove('hidden');
            } else if (screenName === 'battle') {
                document.getElementById('screenBattle').classList.remove('hidden');
                btnMapNav.classList.remove('hidden');
                hudStats.classList.remove('hidden');
            } else if (screenName === 'summary') {
                renderSummary();
                document.getElementById('screenSummary').classList.remove('hidden');
                btnMapNav.classList.remove('hidden');
                hudStats.classList.remove('hidden');
            }
            updateHUD();
        }

        function updateHUD() {
            // Update Hearts
            let heartsStr = '';
            for (let i = 0; i < gameState.maxHp; i++) {
                heartsStr += i < gameState.hp ? '❤️' : '🖤';
            }
            document.getElementById('hpDisplay').textContent = heartsStr;

            // Update Score
            document.getElementById('scoreDisplay').textContent = gameState.score.toLocaleString();

            // Update Combo
            const comboBadge = document.getElementById('comboBadge');
            if (gameState.combo >= 2) {
                comboBadge.classList.remove('hidden');
                comboBadge.classList.add('flex');
                document.getElementById('comboText').textContent = `Combo x${gameState.combo}`;
            } else {
                comboBadge.classList.add('hidden');
                comboBadge.classList.remove('flex');
            }
        }

        function togglePinyin() {
            playSound('click');
            gameState.showPinyin = !gameState.showPinyin;
            const btn = document.getElementById('btnPinyinToggle');
            const statusText = document.getElementById('pinyinStatusText');

            if (gameState.showPinyin) {
                btn.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-semibold border-2 transition shadow-sm bg-sky-500 text-white border-sky-600 cursor-pointer";
                statusText.textContent = "เปิด";
            } else {
                btn.className = "flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-semibold border-2 transition shadow-sm bg-slate-100 text-slate-600 border-slate-300 cursor-pointer";
                statusText.textContent = "ปิด";
            }

            // Update live battle screen if currently visible
            const qPinyin = document.getElementById('questionPinyin');
            if (qPinyin) {
                qPinyin.style.display = gameState.showPinyin ? 'block' : 'none';
            }
            document.querySelectorAll('.option-pinyin').forEach(el => {
                el.style.display = gameState.showPinyin ? 'block' : 'none';
            });
        }

        // ==========================================
        // 5. START, MAP & STAGE SELECTION
        // ==========================================
        function startNewGame() {
            playSound('click');
            gameState.hp = 3;
            gameState.score = 0;
            gameState.combo = 0;
            gameState.maxCombo = 0;
            gameState.completedStages = {};
            gameState.stageAttempts = {};
            showScreen('map');
        }

        function renderMap() {
            const container = document.getElementById('zonesContainer');
            container.innerHTML = '';

            const completedCount = Object.keys(gameState.completedStages).length;
            document.getElementById('mapProgressText').textContent = `${completedCount} / 9 ด่าน`;

            // Show summary button if all 9 stages completed
            const btnSummary = document.getElementById('btnViewSummaryFromMap');
            if (completedCount === 9) {
                btnSummary.classList.remove('hidden');
            } else {
                btnSummary.classList.add('hidden');
            }

            const zones = [
                { id: 1, title: "โซนที่ 1: ป่าไผ่เริ่มต้น (ด่าน 1 - 3)", bg: "from-emerald-50 to-teal-50", border: "border-emerald-200", badge: "bg-emerald-500" },
                { id: 2, title: "โซนที่ 2: เมืองหลวงยุทธภพ (ด่าน 4 - 6)", bg: "from-sky-50 to-indigo-50", border: "border-sky-200", badge: "bg-sky-500" },
                { id: 3, title: "โซนที่ 3: หุบเขามังกรคำศัพท์ (ด่าน 7 - 9)", bg: "from-pink-50 to-purple-50", border: "border-pink-200", badge: "bg-pink-600" }
            ];

            zones.forEach(zone => {
                const zoneStages = STAGES_DATA.filter(s => s.zone === zone.id);
