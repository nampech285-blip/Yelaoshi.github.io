                zoneStages.forEach(stage => {
                    const isCompleted = gameState.completedStages[stage.id] !== undefined;
                    // Unlock logic: Stage 1 is always unlocked, or if previous stage is completed
                    const isUnlocked = stage.id === 1 || gameState.completedStages[stage.id - 1] !== undefined || isCompleted;
                    const stars = gameState.completedStages[stage.id] || 0;
                    const isBoss = stage.id === 9;

