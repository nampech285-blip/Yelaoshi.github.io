                                    <div>
                                        <div class="text-[11px] font-bold ${isBoss ? 'text-rose-600' : 'text-purple-600'}">
                                            ด่านที่ ${stage.id} ${isBoss ? '👑 BOSS' : ''}
                                        </div>
                                        <div class="font-extrabold text-slate-800 text-sm leading-tight">
                                            ${stage.bossName}
                                        </div>
                                        <div class="text-xs mt-1 tracking-wider ${isCompleted ? 'text-amber-500' : 'text-slate-300'}">
                                            ${starDisplay}
                                        </div>
                                    </div>
                                </div>
                                <div class="text-lg font-bold ${isCompleted ? 'text-emerald-500' : 'text-purple-500'}">
                                    ${isCompleted ? '✅' : '▶️'}
                                </div>
                            </button>
                        `;
                    } else {
                        cardsHtml += `
                            <div class="bg-slate-100/80 rounded-2xl p-3.5 border-2 border-slate-200 flex items-center justify-between gap-3 opacity-65 cursor-not-allowed">
                                <div class="flex items-center gap-3">
                                    <div class="w-12 h-12 rounded-xl bg-slate-300 text-slate-500 flex items-center justify-center text-2xl">
                                        🔒
                                    </div>
                                    <div>
                                        <div class="text-[11px] font-bold text-slate-500">ด่านที่ ${stage.id}</div>
                                        <div class="font-bold text-slate-500 text-sm">${stage.bossName}</div>
                                        <div class="text-[11px] text-slate-400 mt-0.5">ผ่านด่าน ${stage.id - 1} เพื่อปลดล็อก</div>
                                    </div>
                                </div>
                            </div>
                        `;
                    }
                });

                cardsHtml += `</div>`;

                zoneDiv.innerHTML = `
                    <div class="flex items-center gap-2">
                        <span class="${zone.badge} text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                            ${zone.title}
                        </span>
                    </div>
                    ${cardsHtml}
                `;

                container.appendChild(zoneDiv);
            });
        }

        // ==========================================
        // 6. BATTLE & QUESTION ENGINE
        // ==========================================
        function loadStage(index) {
            playSound('click');
            gameState.currentStageIndex = index;
            gameState.answeredCurrent = false;
            const stage = STAGES_DATA[index];

            // Reset attempts for this stage
            gameState.stageAttempts[stage.id] = 0;

            // Ensure HP is at least 1 when entering a stage
            if (gameState.hp <= 0) {
                gameState.hp = 3;
            }

            // Populate Stage Headers & Arena
            document.getElementById('battleZoneBadge').textContent = stage.zoneName;
            document.getElementById('battleStageTitle').textContent = `ด่านที่ ${stage.id} / 9`;
            document.getElementById('battleDifficultyBadge').textContent = stage.difficulty;
            document.getElementById('bossNameBadge').textContent = stage.bossName;
            document.getElementById('bossSprite').textContent = stage.bossEmoji;
            document.getElementById('battleStatusEmoji').textContent = '⚔️';
            document.getElementById('battleActionText').textContent = 'เลือกคำตอบเพื่อโจมตี!';

            // Question Text & Pinyin
            document.getElementById('questionChinese').textContent = stage.sentence;
            const qPinyin = document.getElementById('questionPinyin');
            qPinyin.textContent = stage.pinyin;
            qPinyin.style.display = gameState.showPinyin ? 'block' : 'none';

            // Prepare Options (optionally shuffled on replay)
            let opts = [...stage.options];
            if (gameState.shuffleOptions) {
                opts.sort(() => Math.random() - 0.5);
            }

            const optionsGrid = document.getElementById('optionsGrid');
            optionsGrid.innerHTML = '';

            const labels = ['A', 'B', 'C', 'D'];
            opts.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "option-btn btn-3d bg-white hover:bg-indigo-50 border-2 border-indigo-200 hover:border-indigo-400 rounded-2xl p-4 text-left flex items-center gap-4 shadow-sm cursor-pointer transition-all";
                btn.dataset.word = opt.word;
                btn.onclick = () => checkAnswer(btn, opt);

                btn.innerHTML = `
                    <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-700 font-extrabold flex items-center justify-center text-base shrink-0">
                        ${labels[idx]}
                    </div>
                    <div>
                        <div class="zh-font text-2xl sm:text-3xl font-bold text-slate-800 leading-tight">
                            ${opt.word}
                        </div>
                        <div class="option-pinyin text-xs sm:text-sm font-medium text-sky-600 mt-0.5" style="display: ${gameState.showPinyin ? 'block' : 'none'};">
                            ${opt.pinyin}
                        </div>
                    </div>
                `;
                optionsGrid.appendChild(btn);
            });

            showScreen('battle');
        }

        function checkAnswer(btnElement, selectedOpt) {
            if (gameState.answeredCurrent) return;

            const stage = STAGES_DATA[gameState.currentStageIndex];
            const isCorrect = selectedOpt.word === stage.correctWord;

            const heroSprite = document.getElementById('heroSprite');
            const bossSprite = document.getElementById('bossSprite');
            const arena = document.getElementById('battleArena');

            if (isCorrect) {
                // CORRECT ANSWER!
                gameState.answeredCurrent = true;
                playSound('correct');

                // Hero attack animation
                heroSprite.classList.remove('animate-attack-hero');
                void heroSprite.offsetWidth;
                heroSprite.classList.add('animate-attack-hero');

                setTimeout(() => {
                    bossSprite.classList.add('animate-shake');
                    bossSprite.textContent = '💥';
                }, 180);

                // Style selected button green
                btnElement.className = "option-btn btn-3d bg-emerald-500 text-white border-2 border-emerald-700 rounded-2xl p-4 text-left flex items-center gap-4 shadow-md";
                btnElement.querySelector('div:first-child').className = "w-10 h-10 rounded-xl bg-white text-emerald-700 font-extrabold flex items-center justify-center text-base shrink-0";
                btnElement.querySelector('.zh-font').classList.replace('text-slate-800', 'text-white');
                const pEl = btnElement.querySelector('.option-pinyin');
                if (pEl) pEl.classList.replace('text-sky-600', 'text-emerald-100');

                // Disable all option buttons
                document.querySelectorAll('.option-btn').forEach(b => b.disabled = true);

                // Calculate Combo & Score
                gameState.combo += 1;
                if (gameState.combo > gameState.maxCombo) {
                    gameState.maxCombo = gameState.combo;
                }

                const wrongCount = gameState.stageAttempts[stage.id] || 0;
                const starsEarned = wrongCount === 0 ? 3 : (wrongCount === 1 ? 2 : 1);
                const basePoints = 100;
                const comboBonus = (gameState.combo - 1) * 25;
                const totalEarned = basePoints + comboBonus;

                gameState.score += totalEarned;

                // Save highest stars for this stage
                const prevStars = gameState.completedStages[stage.id] || 0;
                if (starsEarned > prevStars) {
                    gameState.completedStages[stage.id] = starsEarned;
                }

                updateHUD();

                document.getElementById('battleStatusEmoji').textContent = '🎯';
                document.getElementById('battleActionText').textContent = `โจมตีสำเร็จ! +${totalEarned} คะแนน`;

                // Show Explanation Modal after short animation delay
                setTimeout(() => {
                    showExplanationModal(stage, totalEarned, starsEarned);
                }, 650);

            } else {
                // WRONG ANSWER!
                playSound('wrong');
                gameState.combo = 0;
                gameState.hp = Math.max(0, gameState.hp - 1);
                gameState.stageAttempts[stage.id] = (gameState.stageAttempts[stage.id] || 0) + 1;

                // Boss attack & Arena shake
                bossSprite.classList.remove('animate-attack-boss');
                void bossSprite.offsetWidth;
                bossSprite.classList.add('animate-attack-boss');

                arena.classList.remove('animate-shake');
                void arena.offsetWidth;
                arena.classList.add('animate-shake');

                // Mark wrong button red & disable it
                btnElement.disabled = true;
                btnElement.className = "option-btn bg-rose-100 border-2 border-rose-300 rounded-2xl p-4 text-left flex items-center gap-4 opacity-75 cursor-not-allowed";
                btnElement.querySelector('div:first-child').className = "w-10 h-10 rounded-xl bg-rose-500 text-white font-extrabold flex items-center justify-center text-base shrink-0";
                btnElement.querySelector('div:first-child').textContent = "✕";

                document.getElementById('battleStatusEmoji').textContent = '💥';
                document.getElementById('battleActionText').textContent = 'พลาดเป้า! ลองเลือกข้ออื่นดูนะ';

                updateHUD();

                // Check Game Over (HP == 0)
                if (gameState.hp === 0) {
                    setTimeout(() => {
                        document.getElementById('gameOverModal').classList.remove('hidden');
                    }, 500);
                }
            }
        }

        // ==========================================
        // 7. EXPLANATION MODAL & PROGRESSION
        // ==========================================
        function showExplanationModal(stage, pointsEarned, starsEarned) {
            const correctObj = stage.options.find(o => o.word === stage.correctWord);

            document.getElementById('modalScoreEarned').textContent = `+${pointsEarned} คะแนน (คอมโบ x${gameState.combo})`;
            
            let starsStr = '';
            for (let i = 1; i <= 3; i++) {
                starsStr += i <= starsEarned ? '⭐' : '☆';
            }
            document.getElementById('modalStarsEarned').textContent = starsStr;

            document.getElementById('modalCorrectWord').textContent = correctObj.word;
            document.getElementById('modalCorrectPinyin').textContent = `(${correctObj.pinyin})`;
            document.getElementById('modalCorrectMeaning').textContent = `— ${correctObj.meaning}`;

            document.getElementById('modalFullSentence').textContent = stage.fullSentence;
            document.getElementById('modalSentenceTrans').textContent = stage.sentenceTrans;
            document.getElementById('modalExplanationText').textContent = stage.explanation;

            const btnNext = document.getElementById('btnModalNext');
            if (gameState.currentStageIndex < STAGES_DATA.length - 1) {
                btnNext.textContent = `ไปด่านที่ ${stage.id + 1} ถัดไป ➡️`;
            } else {
                btnNext.textContent = `🏆 ดูสรุปผลชัยชนะ!`;
            }

            document.getElementById('explanationModal').classList.remove('hidden');
        }

        function handleModalNext() {
            playSound('click');
            document.getElementById('explanationModal').classList.add('hidden');

            if (gameState.currentStageIndex < STAGES_DATA.length - 1) {
                loadStage(gameState.currentStageIndex + 1);
            } else {
                playSound('victory');
                showScreen('summary');
            }
        }

        function retryCurrentStage() {
            playSound('click');
            document.getElementById('gameOverModal').classList.add('hidden');
            gameState.hp = 3;
            updateHUD();
            loadStage(gameState.currentStageIndex);
        }

        function closeGameOverToMap() {
            playSound('click');
            document.getElementById('gameOverModal').classList.add('hidden');
            gameState.hp = 3;
            updateHUD();
            showScreen('map');
        }

