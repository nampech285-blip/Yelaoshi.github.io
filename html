<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A-Level จีน พิชิตด่านจอมยุทธ์ (A-Level Chinese Quest)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Kanit & Noto Sans SC -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;700;900&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Kanit', sans-serif;
            background: linear-gradient(135deg, #fdf2f8 0%, #eff6ff 50%, #f5f3ff 100%);
            min-height: 100vh;
            overflow-x: hidden;
            user-select: none;
        }
        .zh-font {
            font-family: 'Noto Sans SC', sans-serif;
        }
        /* Custom Animations */
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }
        @keyframes attackRight {
            0% { transform: translateX(0) scale(1); }
            40% { transform: translateX(45px) scale(1.15); }
            100% { transform: translateX(0) scale(1); }
        }
        @keyframes attackLeft {
            0% { transform: translateX(0) scale(1); }
            40% { transform: translateX(-45px) scale(1.15); }
            100% { transform: translateX(0) scale(1); }
        }
        @keyframes popIn {
            0% { opacity: 0; transform: scale(0.85) translateY(12px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(236, 72, 153, 0.5); }
            50% { box-shadow: 0 0 0 12px rgba(236, 72, 153, 0); }
        }
        .animate-float { animation: float 3s ease-in-out infinite; }
        .animate-shake { animation: shake 0.45s ease-in-out; }
        .animate-attack-hero { animation: attackRight 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
        .animate-attack-boss { animation: attackLeft 0.45s cubic-bezier(0.22, 1, 0.36, 1); }
        .animate-pop-in { animation: popIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .animate-pulse-glow { animation: pulseGlow 2s infinite; }

        /* 3D Arcade Button Style */
        .btn-3d {
            transition: all 0.12s ease;
            border-bottom-width: 5px;
        }
        .btn-3d:active:not(:disabled) {
            transform: translateY(3px);
            border-bottom-width: 2px;
        }
        
        /* Scrollbar Styling */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="text-slate-800 flex flex-col items-center justify-between p-3 sm:p-5">

    <!-- Top Navigation / Status Header -->
    <header id="gameHeader" class="w-full max-w-4xl bg-white/90 backdrop-blur-md rounded-2xl shadow-lg border-2 border-purple-100 px-4 py-3 mb-4 flex flex-wrap items-center justify-between gap-2 z-20">
        <!-- Left: Logo & Back to Map -->
        <div class="flex items-center gap-2 sm:gap-3">
            <button id="btnMapNav" onclick="showScreen('map')" class="hidden bg-purple-100 hover:bg-purple-200 text-purple-700 font-semibold px-3 py-1.5 rounded-xl text-sm transition flex items-center gap-1 shadow-sm">
                <span>🗺️</span> <span class="hidden sm:inline">แผนที่ด่าน</span>
            </button>
            <div class="flex items-center gap-2">
                <span class="text-2xl">🥋</span>
                <div>
                    <h1 class="font-extrabold text-sm sm:text-base bg-gradient-to-r from-pink-600 via-purple-600 to-indigo-600 bg-clip-text text-transparent leading-tight">
                        A-Level จีน พิชิตด่านจอมยุทธ์
                    </h1>
                    <p class="text-[11px] text-slate-400 font-medium hidden sm:block">A-Level Chinese Quest • 9 ด่านทดสอบ</p>
                </div>
            </div>
        </div>

        <!-- Center: HP, Score & Combo -->
        <div id="hudStats" class="hidden flex items-center gap-2 sm:gap-4">
            <!-- HP Hearts -->
            <div class="flex items-center bg-rose-50 border border-rose-200 px-2.5 py-1 rounded-xl" title="พลังชีวิต (HP)">
                <div id="hpDisplay" class="flex gap-1 text-base sm:text-lg">❤️❤️❤️</div>
            </div>

            <!-- Score -->
            <div class="flex items-center gap-1.5 bg-amber-50 border border-amber-200 px-3 py-1 rounded-xl">
                <span class="text-base">🏆</span>
                <span id="scoreDisplay" class="font-bold text-amber-700 text-sm sm:text-base">0</span>
            </div>

            <!-- Combo Badge -->
            <div id="comboBadge" class="hidden items-center gap-1 bg-gradient-to-r from-orange-500 to-pink-500 text-white font-extrabold px-2.5 py-1 rounded-xl text-xs sm:text-sm shadow-md animate-bounce">
                <span>🔥</span>
                <span id="comboText">x2</span>
            </div>
        </div>

        <!-- Right: Toggles (Pinyin & Sound) -->
        <div class="flex items-center gap-2">
            <!-- Pinyin Toggle -->
            <button id="btnPinyinToggle" onclick="togglePinyin()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-semibold border-2 transition shadow-sm bg-sky-500 text-white border-sky-600" title="เปิด/ปิด พินอิน">
                <span>🔤</span>
                <span>พินอิน: <strong id="pinyinStatusText">เปิด</strong></span>
            </button>

            <!-- Sound Toggle -->
            <button id="btnSoundToggle" onclick="toggleSound()" class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 transition shadow-sm" title="เปิด/ปิด เสียงเอฟเฟกต์">
                <span id="soundIcon" class="text-base sm:text-lg">🔊</span>
            </button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="w-full max-w-4xl flex-grow flex flex-col items-center justify-center relative">

        <!-- ==================== 1. START SCREEN ==================== -->
        <section id="screenStart" class="w-full bg-white rounded-3xl shadow-xl border-4 border-purple-100 p-6 sm:p-10 text-center animate-pop-in relative overflow-hidden">
            <!-- Decorative Background Circles -->
            <div class="absolute -top-12 -left-12 w-40 h-40 bg-pink-200/40 rounded-full blur-2xl pointer-events-none"></div>
            <div class="absolute -bottom-12 -right-12 w-48 h-48 bg-sky-200/50 rounded-full blur-2xl pointer-events-none"></div>

            <div class="inline-block bg-gradient-to-r from-pink-500 to-orange-400 text-white text-xs sm:text-sm font-bold px-4 py-1 rounded-full mb-4 shadow-sm">
                ✨ ตะลุยโจทย์คำศัพท์ & สำนวน A-Level ภาษาจีน
            </div>

            <!-- Hero Avatar Showcase -->
            <div class="flex justify-center items-center gap-4 my-4">
                <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-3xl bg-gradient-to-br from-sky-400 to-indigo-500 flex items-center justify-center text-5xl sm:text-6xl shadow-lg border-4 border-white animate-float">
                    🐼
                </div>
                <div class="text-3xl font-black text-pink-500">VS</div>
                <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-3xl bg-gradient-to-br from-rose-500 to-purple-600 flex items-center justify-center text-5xl sm:text-6xl shadow-lg border-4 border-white animate-float" style="animation-delay: 0.6s;">
                    👹
                </div>
            </div>

            <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-800 mb-2">
                A-Level จีน <span class="bg-gradient-to-r from-pink-600 to-purple-600 bg-clip-text text-transparent">พิชิตด่านจอมยุทธ์</span>
            </h2>
            <p class="text-slate-600 text-sm sm:text-base max-w-xl mx-auto mb-6 leading-relaxed">
                สวมบทบาท <strong class="text-indigo-600">"จอมยุทธ์น้อย"</strong> ผจญภัยฝ่าด่านทดสอบทั้ง <strong>9 ด่าน (3 โซน)</strong> เพื่อปราบบอสใหญ่แห่งหุบเขาสำนวนจีน! สะสมคอมโบ เก็บดาว และเรียนรู้คำอธิบายละเอียดทุกข้อ
            </p>

            <!-- Feature Badges -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 max-w-2xl mx-auto mb-8 text-xs sm:text-sm">
                <div class="bg-pink-50 border border-pink-200 rounded-2xl p-3 font-medium text-pink-800">
                    <div class="text-xl mb-1">🗺️</div>
                    9 ด่านผจญภัย
                </div>
                <div class="bg-sky-50 border border-sky-200 rounded-2xl p-3 font-medium text-sky-800">
                    <div class="text-xl mb-1">🔤</div>
                    เปิด/ปิดพินอินได้
                </div>
                <div class="bg-amber-50 border border-amber-200 rounded-2xl p-3 font-medium text-amber-800">
                    <div class="text-xl mb-1">🔥</div>
                    ระบบคอมโบ & ดาว
                </div>
                <div class="bg-purple-50 border border-purple-200 rounded-2xl p-3 font-medium text-purple-800">
                    <div class="text-xl mb-1">📖</div>
                    เฉลยละเอียดทุกข้อ
                </div>
            </div>

            <button onclick="startNewGame()" class="btn-3d animate-pulse-glow bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-600 hover:from-pink-600 hover:to-indigo-700 text-white font-extrabold text-lg sm:text-xl px-10 py-4 rounded-2xl border-indigo-800 shadow-xl cursor-pointer inline-flex items-center gap-3">
                <span>⚔️</span>
                <span>เริ่มการผจญภัยเลย!</span>
            </button>
        </section>

        <!-- ==================== 2. STAGE MAP SCREEN ==================== -->
        <section id="screenMap" class="hidden w-full bg-white rounded-3xl shadow-xl border-4 border-sky-100 p-5 sm:p-8 animate-pop-in">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6 border-b border-slate-100 pb-4">
                <div>
                    <h2 class="text-xl sm:text-2xl font-extrabold text-slate-800 flex items-center gap-2">
                        <span>🗺️</span> แผนที่เส้นทางจอมยุทธ์ (เลือกด่านท้าประลอง)
                    </h2>
                    <p class="text-slate-500 text-xs sm:text-sm">พิชิตให้ครบทั้ง 9 ด่านเพื่อปลดล็อกฉายาปรมาจารย์ A-Level!</p>
                </div>
                <div class="flex items-center gap-3 bg-slate-50 px-4 py-2 rounded-2xl border border-slate-200 self-start sm:self-auto">
                    <span class="text-sm font-semibold text-slate-600">ความคืบหน้า:</span>
                    <span id="mapProgressText" class="font-extrabold text-purple-600 text-base">0 / 9 ด่าน</span>
                </div>
            </div>

            <!-- 3 Zones Grid -->
            <div id="zonesContainer" class="space-y-6">
                <!-- Zones & Stages will be rendered here by JS -->
            </div>

            <!-- Bottom Actions on Map -->
            <div class="mt-6 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
                <button onclick="resetGameConfirm()" class="text-xs sm:text-sm text-slate-500 hover:text-rose-600 font-medium underline cursor-pointer">
                    🔄 รีเซ็ตความคืบหน้า (เริ่มใหม่ทั้งหมด)
                </button>
                <button id="btnViewSummaryFromMap" onclick="showSummaryScreen()" class="hidden btn-3d bg-amber-400 hover:bg-amber-500 text-amber-950 font-bold px-5 py-2.5 rounded-xl border-amber-600 text-sm shadow-md cursor-pointer">
                    🏆 ดูสรุปผลคะแนน & ทบทวนคำศัพท์
                </button>
            </div>
        </section>

        <!-- ==================== 3. BATTLE / QUIZ SCREEN ==================== -->
        <section id="screenBattle" class="hidden w-full bg-white rounded-3xl shadow-xl border-4 border-pink-100 p-4 sm:p-7 animate-pop-in">
            <!-- Stage Top Info -->
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <div class="flex items-center gap-2">
                    <span id="battleZoneBadge" class="bg-purple-100 text-purple-700 text-xs font-bold px-3 py-1 rounded-full">
                        โซนที่ 1
                    </span>
                    <span id="battleStageTitle" class="font-extrabold text-slate-800 text-base sm:text-lg">
                        ด่านที่ 1
                    </span>
                </div>
                <span id="battleDifficultyBadge" class="text-xs font-bold px-3 py-1 rounded-full bg-sky-100 text-sky-700">
                    ระดับ: ศิษย์สำนักต้น
                </span>
            </div>

            <!-- Battle Arena Visual -->
            <div id="battleArena" class="relative w-full rounded-2xl p-4 sm:p-6 mb-5 overflow-hidden border-2 border-indigo-100 bg-gradient-to-r from-sky-100 via-purple-50 to-pink-100 flex items-center justify-between">
                <!-- Player Character -->
                <div class="flex flex-col items-center z-10 w-1/3">
                    <div class="bg-white/90 px-2.5 py-0.5 rounded-full text-[11px] sm:text-xs font-bold text-indigo-700 shadow-sm mb-1.5">
                        จอมยุทธ์น้อย (คุณ)
                    </div>
                    <div id="heroSprite" class="w-16 h-16 sm:w-22 sm:h-22 rounded-2xl bg-gradient-to-br from-sky-400 to-indigo-600 flex items-center justify-center text-4xl sm:text-5xl shadow-md border-2 border-white">
                        🐼
                    </div>
                </div>

                <!-- Center VS / Action Text -->
                <div class="flex flex-col items-center justify-center z-10 text-center w-1/3">
                    <div id="battleStatusEmoji" class="text-2xl sm:text-3xl mb-1">⚔️</div>
                    <div id="battleActionText" class="text-xs sm:text-sm font-bold text-slate-600 bg-white/80 px-3 py-1 rounded-full shadow-sm">
                        เลือกคำตอบเพื่อโจมตี!
                    </div>
                </div>

                <!-- Enemy / Boss Character -->
                <div class="flex flex-col items-center z-10 w-1/3">
                    <div id="bossNameBadge" class="bg-rose-600 text-white px-2.5 py-0.5 rounded-full text-[11px] sm:text-xs font-bold shadow-sm mb-1.5">
                        ผู้พิทักษ์ด่าน 1
                    </div>
                    <div id="bossSprite" class="w-16 h-16 sm:w-22 sm:h-22 rounded-2xl bg-gradient-to-br from-orange-400 to-rose-600 flex items-center justify-center text-4xl sm:text-5xl shadow-md border-2 border-white">
                        🦊
                    </div>
                </div>
            </div>

            <!-- Question Card -->
            <div class="bg-slate-50 border-2 border-slate-200 rounded-2xl p-5 sm:p-6 mb-5 text-center shadow-inner">
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">
                    จงเลือกคำศัพท์หรือสำนวนที่เหมาะสมที่สุดเติมลงในช่องว่าง
                </div>
                
                <!-- Chinese Sentence -->
                <p id="questionChinese" class="zh-font text-2xl sm:text-3xl md:text-4xl font-bold text-slate-800 leading-relaxed tracking-wide mb-2">
                    他每天都能_________到学校，从不迟到。
                </p>

                <!-- Pinyin Sentence (Toggleable) -->
                <p id="questionPinyin" class="text-sm sm:text-base font-medium text-sky-600 transition-all">
                    Tā měitiān dōu néng _________ dào xuéxiào, cóng bù chídào.
                </p>
            </div>

            <!-- 4 Multiple Choice Options -->
            <div id="optionsGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                <!-- Options rendered by JS -->
            </div>
        </section>

        <!-- ==================== 4. SUMMARY / VICTORY SCREEN ==================== -->
        <section id="screenSummary" class="hidden w-full bg-white rounded-3xl shadow-xl border-4 border-amber-200 p-6 sm:p-8 animate-pop-in">
            <div class="text-center mb-6">
                <div id="summaryTrophy" class="text-6xl sm:text-7xl mb-3 animate-bounce">🏆</div>
                <div class="inline-block bg-amber-100 text-amber-800 text-xs sm:text-sm font-bold px-4 py-1 rounded-full mb-2">
                    ภารกิจเสร็จสิ้น!
                </div>
                <h2 id="summaryRankTitle" class="text-2xl sm:text-4xl font-black bg-gradient-to-r from-amber-500 via-pink-600 to-purple-600 bg-clip-text text-transparent mb-2">
                    ปรมาจารย์ A-Level ภาษาจีน
                </h2>
                <p id="summarySubtitle" class="text-slate-600 text-sm sm:text-base">
                    สุดยอดมาก! คุณพิชิตข้อสอบ A-Level ภาษาจีนได้สำเร็จ!
                </p>
            </div>

            <!-- Score & Stats Cards -->
            <div class="grid grid-cols-3 gap-3 max-w-xl mx-auto mb-6 text-center">
                <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-3 sm:p-4">
                    <div class="text-xs text-amber-700 font-semibold">คะแนนรวม</div>
                    <div id="finalScoreText" class="text-2xl sm:text-3xl font-black text-amber-600">0</div>
                </div>
                <div class="bg-pink-50 border-2 border-pink-200 rounded-2xl p-3 sm:p-4">
                    <div class="text-xs text-pink-700 font-semibold">ดาวที่สะสม</div>
                    <div id="finalStarsText" class="text-2xl sm:text-3xl font-black text-pink-600">0 / 27 ⭐</div>
                </div>
                <div class="bg-sky-50 border-2 border-sky-200 rounded-2xl p-3 sm:p-4">
                    <div class="text-xs text-sky-700 font-semibold">คอมโบสูงสุด</div>
                    <div id="finalMaxComboText" class="text-2xl sm:text-3xl font-black text-sky-600">x0</div>
                </div>
            </div>

            <!-- Vocabulary Review List -->
            <div class="bg-slate-50 border-2 border-slate-200 rounded-2xl p-4 sm:p-5 mb-6">
                <h3 class="font-extrabold text-slate-800 text-base sm:text-lg mb-3 flex items-center gap-2">
                    <span>📚</span> สรุปคลังคำศัพท์ & สำนวนที่พบในเกม (9 ข้อ)
                </h3>
                <div id="vocabReviewList" class="space-y-2.5 max-h-72 overflow-y-auto pr-1">
                    <!-- Rendered by JS -->
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                <button onclick="showScreen('map')" class="btn-3d w-full sm:w-auto bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold px-6 py-3.5 rounded-2xl border-slate-300 cursor-pointer">
                    🗺️ กลับไปดูแผนที่ด่าน
                </button>
                <button onclick="replayWithShuffle()" class="btn-3d w-full sm:w-auto bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-600 hover:to-purple-700 text-white font-extrabold px-8 py-3.5 rounded-2xl border-purple-800 shadow-lg cursor-pointer">
                    🔄 เล่นใหม่อีกครั้ง (สลับลำดับตัวเลือก)
                </button>
            </div>
        </section>

    </main>

    <!-- ==================== EXPLANATION MODAL POPUP ==================== -->
    <div id="explanationModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-3 sm:p-5">
        <div class="bg-white w-full max-w-xl rounded-3xl shadow-2xl border-4 border-purple-200 overflow-hidden animate-pop-in flex flex-col max-h-[90vh]">
            <!-- Modal Header -->
            <div id="modalHeaderBanner" class="px-6 py-4 text-white flex items-center justify-between bg-gradient-to-r from-emerald-500 to-teal-600">
                <div class="flex items-center gap-3">
                    <span id="modalResultIcon" class="text-3xl">🎉</span>
                    <div>
                        <h3 id="modalResultTitle" class="font-extrabold text-lg sm:text-xl">ยอดเยี่ยม! ตอบถูกต้อง</h3>
                        <p id="modalScoreEarned" class="text-xs sm:text-sm text-white/90 font-medium">+100 คะแนน!</p>
                    </div>
                </div>
                <div id="modalStarsEarned" class="text-xl sm:text-2xl tracking-widest">⭐⭐⭐</div>
            </div>

            <!-- Modal Content (Scrollable) -->
            <div class="p-5 sm:p-6 overflow-y-auto space-y-4">
                <!-- Correct Answer Box -->
                <div class="bg-emerald-50 border-2 border-emerald-200 rounded-2xl p-4">
                    <div class="text-xs font-bold text-emerald-700 mb-1">✅ คำตอบที่ถูกต้อง:</div>
                    <div class="flex flex-wrap items-baseline gap-2">
                        <span id="modalCorrectWord" class="zh-font text-2xl sm:text-3xl font-black text-emerald-800">按时</span>
                        <span id="modalCorrectPinyin" class="text-base sm:text-lg font-bold text-emerald-600">(ànshí)</span>
                        <span id="modalCorrectMeaning" class="text-sm sm:text-base font-semibold text-slate-700">— ตรงเวลา / ตามเวลาที่กำหนด</span>
                    </div>
                </div>

                <!-- Full Sentence Translation -->
                <div class="bg-sky-50 border border-sky-200 rounded-2xl p-3.5">
                    <div class="text-xs font-bold text-sky-700 mb-1">💬 ประโยคสมบูรณ์ & คำแปล:</div>
                    <p id="modalFullSentence" class="zh-font font-bold text-slate-800 text-base sm:text-lg">他每天都能按时到学校，从不迟到。</p>
                    <p id="modalSentenceTrans" class="text-slate-600 text-xs sm:text-sm mt-1">เขาสามารถมาถึงโรงเรียนได้ตรงเวลาทุกวัน ไม่เคยมาสายเลย</p>
