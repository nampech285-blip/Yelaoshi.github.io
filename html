        function replayWithShuffle() {
            playSound('click');
            gameState.hp = 3;
            gameState.score = 0;
            gameState.combo = 0;
            gameState.maxCombo = 0;
            gameState.completedStages = {};
            gameState.stageAttempts = {};
            gameState.shuffleOptions = true; // Shuffle options on replay
            loadStage(0);
        }

        function resetGameConfirm() {
            playSound('click');
            document.getElementById('confirmResetModal').classList.remove('hidden');
        }

        function executeFullReset() {
            playSound('click');
            document.getElementById('confirmResetModal').classList.add('hidden');
            gameState.hp = 3;
            gameState.score = 0;
            gameState.combo = 0;
            gameState.maxCombo = 0;
            gameState.completedStages = {};
            gameState.stageAttempts = {};
            gameState.shuffleOptions = false;
            showScreen('start');
        }

        // Initialize on load
        window.onload = () => {
            showScreen('start');
        };
    </script>
</body>
</html>